# Project: NYC Housing Price Predictor
# Description: Trains a random forest model on cleaned NYC real estate data.
#              Ensures all coordinates fall within users chose boundaries.
# Usage:       mlflow run components/test_regression_model -P mlflow_model=mlflow_model \
#                   -P test_artifact=test_artifact
#           or
#             mlflow run . -P steps="test_regression_model"
# =============================================================================

name: test_model
conda_env: conda.yml

entry_points:
  main:
    parameters:

      mlflow_model:
        description: An MLflow serialized model
        type: string

      test_artifact:
        description: The test artifact
        type: string

    command: "python run.py  --mlflow_model {mlflow_model} --test_artifact {test_artifact}"
