# Description: Trains a random forest model on cleaned NYC real estate data.
#              Ensures all coordinates fall within users chose boundaries.
# Usage:       mlflow run components/train_val_test_split -P input="dataset.csv:latest" \
#                   -P test_size=test_size \
#                   -P random_seed=random_seed \
#                   -P stratify_by=stratify_by \
#           or
#             mlflow run . -P steps="data_split"
# =============================================================================
name: train_val_test_split
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input:
        description: Artifact to split (a CSV file)
        type: string

      test_size:
        description: Size of the test split. Fraction of the dataset, or number of items
        type: string

      random_seed:
        description: Seed for the random number generator. Use this for reproducibility
        type: string
        default: 42

      stratify_by:
        description: Column to use for stratification (if any)
        type: string
        default: 'none'

    command: "python run.py {input} {test_size} --random_seed {random_seed} --stratify_by {stratify_by}"
